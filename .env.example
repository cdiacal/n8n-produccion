# Copia este fichero a .env y rellena los valores.
# Genera los secretos con: ./scripts/generar-secretos.sh

# --- Versión ---
# Fija siempre una versión concreta. n8n publica versión menor casi cada semana
# y usar :latest significa que un reinicio puede cambiarte la versión sin avisar.
N8N_VERSION=1.123.5

# --- Dominio ---
# Dominio público que apunta a este servidor. Caddy pedirá el certificado solo.
N8N_HOST=n8n.tudominio.com

# --- Clave de cifrado ---
# CRÍTICO: si pierdes esta clave, pierdes TODAS las credenciales guardadas.
# Guárdala fuera del servidor antes de arrancar nada. No la cambies nunca
# sobre una instancia con datos.
N8N_ENCRYPTION_KEY=

# --- PostgreSQL ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Escalado ---
# Cada worker procesa WORKER_CONCURRENCY ejecuciones en paralelo.
# Empieza bajo y sube mirando CPU y memoria, no a ojo.
WORKER_REPLICAS=2
WORKER_CONCURRENCY=5

# --- Retención ---
# Sin pruning, la tabla de ejecuciones crece hasta llenarte el disco.
# 336 horas = 14 días.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# --- Zona horaria ---
TZ=Atlantic/Canary
